{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/hook_state.py", "clear"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/session_start_hook.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/sanitize_backfill_hook.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/recorder_autostart_hook.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/stop_hook.py"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/user_prompt_submit_hook.py"]
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/feedback_hook.py"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/preblock_hook.py"]
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/feedback_hook.py"]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/deny_nested_bg_hook.py"]
          }
        ]
      },
      {
        "matcher": "mcp__.*calm__.*|mcp__.*cc-memory__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/agent_identity_hook.py"]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/feedback_hook.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/sanitize_tool_result_hook.py"]
          }
        ]
      },
      {
        "matcher": "mcp__.*calm__add_ask",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "-q", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/ask_answer_rewake_hook.py"],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-X", "utf8", "hooks/message_display_id_titles.py"]
          }
        ]
      }
    ]
  }
}
